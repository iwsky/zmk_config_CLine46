#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        LeftClick {
            bindings = <&none>;
            key-positions = <19 20>;
        };

        RightClick {
            bindings = <&none>;
            key-positions = <20 21>;
        };

        ScrollMode {
            bindings = <&none>;
            key-positions = <31 20>;
        };

        MiddleClick {
            bindings = <&none>;
            key-positions = <19 8>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DefaultLayer {
            bindings = <
&kp ESC     &kp Q      &kp W     &kp E     &kp R           &kp T                                           &kp Y        &kp U  &kp I      &kp O       &kp P      &kp LEFT_BRACKET
&kp TAB     &kp A      &kp S     &kp D     &kp F           &kp G                                           &kp H        &kp J  &kp K      &kp L       &kp MINUS  &kp RIGHT_BRACKET
&kp LSHIFT  &kp Z      &kp X     &kp C     &kp V           &kp B                                           &kp N        &kp M  &kp COMMA  &kp DOT     &kp SLASH  &kp RSHIFT
            &kp LCTRL  &kp LGUI  &kp LALT  &kp LANGUAGE_2  &lt 1 SPACE  &lt 2 LANGUAGE_1    &kp BACKSPACE  &lt 6 ENTER                    &kp DELETE  &mo 5
            >;
        };

        Symbol {
            bindings = <
&trans  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp EXCLAMATION  &kp QUESTION  &kp TILDE                         &kp INT_YEN  &kp UNDERSCORE  &none  &none   &kp PERCENT  &none
&trans  &kp AMPERSAND     &kp SEMICOLON      &kp DOLLAR       &none         &kp GRAVE                         &kp CARET    &none           &none  &none   &none        &none
&trans  &none             &none              &kp COLON        &kp PIPE      &kp UNDERSCORE                    &kp HASH     &kp AT_SIGN     &none  &none   &none        &none
        &trans            &trans             &trans           &trans        &trans          &trans    &trans  &trans                              &trans  &trans
            >;
        };

        FunctionAndMove {
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10                     &kp LC(Y)  &kp LC(C)       &kp LC(V)       &kp LC(X)        &kp LC(P)  &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11                     &kp LC(Z)  &mkp MB1        &kp UP_ARROW    &mkp MB2         &kp LC(F)  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12                     &kp LC(A)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans     &trans
        &trans  &trans  &trans  &trans  &trans   &trans    &kp RET  &kp BSPC                                   &kp HOME         &kp END
            >;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };

        BTandUnlock {
            bindings = <
&trans  &trans  &trans  &trans          &trans  &trans                            &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans          &trans  &trans                            &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &bt BT_CLR_ALL  &trans  &trans                            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
        &trans  &trans  &trans          &trans  &trans  &trans    &studio_unlock  &trans                                    &trans        &trans
            >;
        };

        NumAndBracket {
            bindings = <
&trans  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans                    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &trans  &trans
&trans  &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans                    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &trans  &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans                    &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans  &trans  &trans
        &trans  &kp NUMBER_0  &trans        &trans        &trans  &trans    &trans  &trans                                               &trans  &trans
            >;
        };
    };
};
